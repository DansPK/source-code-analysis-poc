# Any OpenAI-compatible endpoint. Leave LLM_MOCK=1 to run the whole pipeline
# with canned responses and no API key at all.
LLM_MOCK=1

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Context bounds passed to the Context Investigator. Raising these grows the
# prompt sent to the LLM -- see AGENTS.md before changing them.
MAX_CALLER_DEPTH=2
MAX_CALLEE_DEPTH=2
MAX_SNIPPET_LINES=40
